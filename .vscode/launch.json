{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Belediye Araç Sistemini Çalıştır",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm.cmd run dev",
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "pattern": "Local.*3000",
        "uriFormat": "http://localhost:3000",
        "action": "openExternally"
      }
    }
  ]
}
